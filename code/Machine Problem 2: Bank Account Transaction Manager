import java.util.Scanner;
 
public class Main {
 
    public static void main(String[] args) {
 
        Scanner input = new Scanner(System.in);
 
        int numberOfAccounts;
 
        // Validate number of accounts
        do {
            System.out.print("Enter number of accounts (1-5): ");
            numberOfAccounts = input.nextInt();
 
            if (numberOfAccounts < 1 || numberOfAccounts > 5) {
                System.out.println("Invalid number. Please enter 1-5.");
            }
 
        } while (numberOfAccounts < 1 || numberOfAccounts > 5);
 
        input.nextLine();
 
        BankAccount[] accounts = new BankAccount[numberOfAccounts];
 
        // Create accounts
        for (int i = 0; i < numberOfAccounts; i++) {
 
            System.out.println("\nAccount " + (i + 1));
 
            System.out.print("Account Number: ");
            String accountNumber = input.nextLine();
 
            System.out.print("Owner Name: ");
            String ownerName = input.nextLine();
 
            double openingBalance;
 
            do {
                System.out.print("Opening Balance: ");
                openingBalance = input.nextDouble();
 
                if (openingBalance < 0) {
                    System.out.println("Invalid balance. Balance cannot be negative.");
                }
 
            } while (openingBalance < 0);
 
            input.nextLine();
 
            accounts[i] = new BankAccount(
                accountNumber,
                ownerName,
                openingBalance
            );
        }
 
        // Number of transactions
        int numberOfTransactions;
 
        do {
            System.out.print("\nEnter number of transactions: ");
            numberOfTransactions = input.nextInt();
 
            if (numberOfTransactions < 1) {
                System.out.println("Invalid number.");
            }
 
        } while (numberOfTransactions < 1);
 
        int transactionCount = 0;
 
        // Process transactions
        for (int i = 0; i < numberOfTransactions; i++) {
 
            System.out.println("\nTransaction " + (i + 1));
 
            input.nextLine();
 
            System.out.print("Account Number: ");
            String accountNumber = input.nextLine();
 
            // Search for account
            BankAccount account = null;
 
            for (int j = 0; j < accounts.length; j++) {
 
                if (accounts[j].getAccountNumber().equals(accountNumber)) {
                    account = accounts[j];
                    break;
                }
            }
 
            if (account == null) {
                System.out.println("Account not found.");
                continue;
            }
 
            System.out.print("Transaction Type (D = Deposit, W = Withdraw): ");
            String type = input.nextLine();
 
            System.out.print("Amount: ");
            double amount = input.nextDouble();
 
            boolean successful = false;
 
            if (type.equalsIgnoreCase("D")) {
 
                successful = account.deposit(amount);
 
            } else if (type.equalsIgnoreCase("W")) {
 
                successful = account.withdraw(amount);
 
            } else {
 
                System.out.println("Invalid transaction type.");
                continue;
            }
 
            transactionCount++;
 
            if (successful) {
                System.out.println("Transaction successful.");
            } else {
                System.out.println("Transaction rejected.");
            }
        }
 
        // Display final balances
        System.out.println("\n========== FINAL ACCOUNT BALANCES ==========");
 
        for (int i = 0; i < accounts.length; i++) {
 
            System.out.printf(
                "%s | %s | Balance: %.2f%n",
                accounts[i].getAccountNumber(),
                accounts[i].getOwnerName(),
                accounts[i].getBalance()
            );
        }
 
        System.out.println("\nTotal Transactions Processed: "
                + transactionCount);
 
        System.out.println("Total Bank Account Objects Created: "
                + BankAccount.getAccountCount());
 
        input.close();
    }
}
 
 
// ================= BANK ACCOUNT CLASS =================
 
class BankAccount {
 
    private String accountNumber;
    private String ownerName;
    private double balance;
 
    private static int accountCount = 0;
 
    // Constructor
    public BankAccount(
            String accountNumber,
            String ownerName,
            double balance) {
 
        this.accountNumber = accountNumber;
        this.ownerName = ownerName;
        this.balance = balance;
 
        accountCount++;
    }
 
    // Getters
    public String getAccountNumber() {
        return accountNumber;
    }
 
    public String getOwnerName() {
        return ownerName;
    }
 
    public double getBalance() {
        return balance;
    }
 
    // Setters
    public void setAccountNumber(String accountNumber) {
        this.accountNumber = accountNumber;
    }
 
    public void setOwnerName(String ownerName) {
        this.ownerName = ownerName;
    }
 
    // Deposit
    public boolean deposit(double amount) {
 
        if (amount <= 0) {
            return false;
        }
 
        balance += amount;
        return true;
    }
 
    // Withdraw
    public boolean withdraw(double amount) {
 
        if (amount <= 0 || amount > balance) {
            return false;
        }
 
        balance -= amount;
        return true;
    }
 
    // Static account counter
    public static int getAccountCount() {
        return accountCount;
    }
}
